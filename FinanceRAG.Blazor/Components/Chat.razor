@page "/chat"
@inject NavigationManager Navigation
@inject IChatService ChatService
@inject IJSRuntime JS

<PageTitle>Yatırım Asistanı</PageTitle>

<div class="chat-container">
    <div class="sidebar">
        <div class="logo">
            <h3>💰 Finansal Asistan</h3>
        </div>
        
        <div class="user-info">
            <p><strong>@UserName</strong></p>
            <p class="small">@UserProfile</p>
        </div>

        <button class="new-chat-btn" @onclick="NewChat">+ Yeni Sohbet</button>
    </div>

    <div class="chat-area">
        <div class="chat-header">
            <h4>Akıllı Yatırım Danışmanı</h4>
            <span class="status">● Çevrimiçi</span>
        </div>

        <div class="messages" id="messageArea">
            @foreach (var msg in Messages)
            {
                <div class="@(msg.IsUser ? "user-message" : "assistant-message")">
                    <div class="message-bubble">
                        @((MarkupString)msg.Content)
                    </div>
                </div>
            }
            @if (IsThinking)
            {
                <div class="assistant-message">
                    <div class="typing">Asistan yazıyor<span class="dots">...</span></div>
                </div>
            }
        </div>

        <div class="input-area">
            <textarea @bind="CurrentMessage" 
                      @onkeydown="HandleKeyDown"
                      placeholder="Sorunuzu yazın... (Örn: Gram altın almak mantıklı mı?)"
                      rows="2"></textarea>
            <button @onclick="SendMessage" disabled="@IsThinking">Gönder</button>
        </div>
    </div>
</div>

@code {
    private List<ChatMessage> Messages = new();
    private string CurrentMessage = "";
    private bool IsThinking = false;
    private string UserName = "Sertaç Benzer";
    private string UserProfile = "Orta Seviye Yatırımcı • 1.2 Milyon TL Portföy";

    protected override void OnInitialized()
    {
        Console.WriteLine("✅ Chat component initialized");
        if (ChatService == null)
            Console.WriteLine("❌ ChatService is NULL!");
        else
            Console.WriteLine("✅ ChatService injected successfully");
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(CurrentMessage) || IsThinking) return;

        Console.WriteLine($"📨 Mesaj gönderiliyor: {CurrentMessage}");

        var userMsg = new ChatMessage { Content = CurrentMessage, IsUser = true };
        Messages.Add(userMsg);
        var question = CurrentMessage;
        CurrentMessage = "";
        IsThinking = true;
        StateHasChanged();

        // Scroll to bottom
        await Task.Delay(100);
        try
        {
            await JS.InvokeVoidAsync("scrollToBottom");
        }
        catch (Exception jsEx)
        {
            Console.WriteLine($"⚠️ JS Scroll Error: {jsEx.Message}");
        }

        try
        {
            Console.WriteLine($"🔄 ChatService çağrılıyor...");
            var response = await ChatService.GetAnswerAsync(question);
            Console.WriteLine($"✅ Yanıt alındı: {response}");
            Messages.Add(new ChatMessage { Content = response, IsUser = false });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Hata: {ex}");
            Messages.Add(new ChatMessage { Content = $"Hata: {ex.Message}", IsUser = false });
        }

        IsThinking = false;
        StateHasChanged();
        await Task.Delay(50);
        try
        {
            await JS.InvokeVoidAsync("scrollToBottom");
        }
        catch { }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private void NewChat()
    {
        Messages.Clear();
    }
}

<style>
    .chat-container {
        display: flex;
        height: 100vh;
        background: #f5f5f5;
    }

    .sidebar {
        width: 280px;
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        padding: 20px;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #ddd;
    }

    .logo h3 {
        margin: 0 0 30px 0;
        font-size: 18px;
        font-weight: 600;
    }

    .user-info {
        margin-bottom: 30px;
        padding: 15px;
        background: rgba(255,255,255,0.1);
        border-radius: 8px;
    }

    .user-info p {
        margin: 5px 0;
    }

    .user-info .small {
        font-size: 12px;
        opacity: 0.8;
    }

    .new-chat-btn {
        padding: 10px 15px;
        background: white;
        color: #2a5298;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        margin-top: auto;
        transition: all 0.3s;
    }

    .new-chat-btn:hover {
        background: #f0f0f0;
    }

    .chat-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: white;
    }

    .chat-header {
        padding: 15px 20px;
        border-bottom: 1px solid #ddd;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-header h4 {
        margin: 0;
        color: #333;
    }

    .status {
        color: #4caf50;
        font-size: 12px;
    }

    .messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .user-message,
    .assistant-message {
        display: flex;
        margin-bottom: 12px;
    }

    .user-message {
        justify-content: flex-end;
    }

    .message-bubble {
        max-width: 70%;
        padding: 12px 16px;
        border-radius: 12px;
        line-height: 1.4;
        word-wrap: break-word;
    }

    .user-message .message-bubble {
        background: #2a5298;
        color: white;
    }

    .assistant-message .message-bubble {
        background: #f0f0f0;
        color: #333;
    }

    .typing {
        padding: 12px 16px;
        background: #f0f0f0;
        border-radius: 12px;
        color: #666;
    }

    .dots {
        animation: blink 1.4s infinite;
    }

    @@keyframes blink {
        0%, 20%, 50%, 80%, 100% { opacity: 1; }
        40% { opacity: 0.5; }
        60% { opacity: 0.7; }
    }

    .input-area {
        padding: 20px;
        border-top: 1px solid #ddd;
        display: flex;
        gap: 10px;
    }

    .input-area textarea {
        flex: 1;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        resize: none;
        font-size: 14px;
    }

    .input-area button {
        padding: 10px 20px;
        background: #2a5298;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s;
    }

    .input-area button:hover {
        background: #1e3c72;
    }

    .input-area button:disabled {
        background: #ccc;
        cursor: not-allowed;
    }
</style>

